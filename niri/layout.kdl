overview {
  backdrop-color "#386184"
}

layout {
  gaps 12

  background-color "#00000000"
  // center-focused-column "on-overflow"

  // Bevel approximation: niri can't colour edges individually, so two 2px
  // rings (Theme.px) (outer focus-ring, inner border) each fade light (top-left) to
  // dark (bottom-right) to mimic quickshell's Bevel "outset".
  focus-ring {
    on

    width 2
    active-gradient from="#8a8a8a" to="#0c0c0c" angle=135
    inactive-gradient from="#5a5a5a" to="#101010" angle=135
  }

  border {
    // Included configs don't implicitly enable the border like the main
    // config does, so this needs to be explicit.
    on

    width 2
    active-gradient from="#4a4a4a" to="#2a2a2a" angle=135
    inactive-gradient from="#363636" to="#202020" angle=135
    urgent-color "#9b0000"
  }

  shadow {
    on

    softness 100
    spread 40
    offset x=0 y=5
    draw-behind-window false
    color "#00000064"
  }

  tab-indicator {
    width 8
    gap 4
    gaps-between-tabs 4

    active-color "#ff5900"
    inactive-color "#3b281e"

    position "left"
    place-within-column
    corner-radius 2
  }

  struts {
    // left 10
    // right 10
    // top 10
    // bottom 10
  }
}

// Alt+Tab switcher: square, chunky 2px bevelled highlight like the bar.
recent-windows {
  debounce-ms 400
  open-delay-ms 100

  highlight {
    active-color "#c0c0c0ff"
    urgent-color "#9b0000ff"
    padding 8
    corner-radius 0
  }

  previews {
    max-height 320
    max-scale 0.4
  }
}

blur {
  passes 0
  offset 2
  noise 0.15
  saturation 1.5
}

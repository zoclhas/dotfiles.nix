workspace "browser"
workspace "work"
workspace "games"
workspace "media"

window-rule {
  match app-id="firefox$"
  match app-id="zen"
  match app-id="chromium"
  open-on-workspace "browser"
}

window-rule {
  match app-id="kitty"
  open-on-workspace "work"
}

window-rule {
  match app-id="steam"
  match app-id="/^steam_app_/"
  match app-id="org.prismlauncher.PrismLauncher"
  match app-id="Minecraft$"
  open-on-workspace "games"
}

window-rule {
  match app-id="cider"
  match app-id="mpv"
  match app-id="com.obsproject.Studio"
  match app-id="GalaxyBudsClient"
  open-on-workspace "media"
}
